# Токен бота из @BotFather
BOT_TOKEN=123456:ABC-your-token

# Публичный https-адрес панели (нужен для кнопок-ссылок и подсчёта переходов)
BASE_URL=https://your-domain.com

# ID канала для учёта подписок. Бот должен быть администратором канала
CHANNEL_ID=-1001234567890

# Пароль для входа в панель
ADMIN_PASSWORD=change-me

# Файл базы данных (необязательно)
DB_PATH=leadbot.db
